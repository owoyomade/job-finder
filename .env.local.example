# Copy this file to .env.local and fill in your keys.

# Anthropic API key (https://console.anthropic.com/settings/keys) — powers resume parsing,
# tailoring, cover letters and interview prep.
ANTHROPIC_API_KEY=

# RapidAPI key subscribed to JSearch (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch).
# Free tier is about 200 requests/month.
RAPIDAPI_KEY=

# Optional: Adzuna (https://developer.adzuna.com/) — free key, adds more Canadian listings.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Set to 1 to use built-in sample data instead of calling the real APIs (for trying the UI).
AI_MOCK=0
JOBS_MOCK=0
